{
    "name": "ugarit/boost",
    "description": "Ugarit Boost accelerates AI-assisted development by providing the essential context and structure that AI needs to generate high-quality, Ugarit-specific code.",
    "keywords": [
        "dev",
        "ugarit",
        "ai"
    ],
    "homepage": "https://github.com/ugarit/boost",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/ugarit/boost/issues",
        "source": "https://github.com/ugarit/boost"
    },
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.9|^8.0",
        "heritage/console": "^1.00.00",
        "heritage/contracts": "^1.00.00",
        "heritage/routing": "^1.00.00",
        "heritage/support": "^1.00.00",
        "ugarit/mcp": "^1.00.00",
        "ugarit/prompts": "^1.00.00",
        "ugarit/roster": "^1.00.00"
    },
    "require-dev": {
        "ugarit/pint": "^1.00.00",
        "mockery/mockery": "^1.6.12",
        "orchestra/testbench": "^9.15.0|^10.6|^11.0",
        "pestphp/pest": "^2.36.0|^3.8.4|^4.1.5",
        "phpstan/phpstan": "^2.1.27",
        "rector/rector": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Ugarit\\Boost\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.x-dev"
        },
        "ugarit": {
            "providers": [
                "Ugarit\\Boost\\BoostServiceProvider"
            ]
        }
    },
    "scripts": {
        "lint": [
            "pint --format agent",
            "phpstan --memory-limit=-1",
            "rector"
        ],
        "test": "pest",
        "test:lint": [
            "pint --test --format agent",
            "rector --dry-run"
        ],
        "test:types": "phpstan --memory-limit=-1",
        "check": [
            "@composer lint",
            "@composer test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "authors": [
        {
            "name": "Muath R Abu Ouda",
            "email": "muathrabuouda@hotmail.com",
            "role": "Vision Leader of Ugarit"
        },
        {
            "name": "Taylor Otwell",
            "email": "taylor@laravel.com",
            "role": "Original Creator & Primary Developer"
        }
    ]
}
